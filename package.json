{
  "name": "reels-editor",
  "productName": "Reels Editor",
  "version": "0.1.0",
  "description": "Video kırpma, düzenleme ve Reels oluşturma masaüstü uygulaması",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.reelseditor.app",
    "productName": "Reels Editor",
    "copyright": "Reels Editor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/ffprobe-static/bin/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Reels Editor",
      "artifactName": "ReelsEditor-Kurulum-${version}.exe"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "sharp@0.35.5": true
  }
}
